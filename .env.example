# Copier ce fichier en `.env` (jamais versionné) et renseigner les vraies
# adresses. Sans ce fichier, l'app démarre en mode hors ligne : les écrans
# restent accessibles mais les fonctions réseau sont indisponibles.
#
# `EXPO_PUBLIC_*` est inliné par Metro au moment du build (@expo/metro-config
# le charge automatiquement) : ces variables doivent être présentes AVANT de
# lancer `expo start` / `expo run:ios` / le build CI, pas seulement au
# démarrage du serveur.

# Serveur API principal (auth, tweets, messagerie, etc.)
EXPO_PUBLIC_API_URL=https://api.exemple.org

# Serveur de stream (ingestion RTMPS, lecture HLS, chat du live)
EXPO_PUBLIC_STREAM_SERVER=https://stream.exemple.org

# Client web, cible des liens de partage (`/tweet/:id`, `/profile/:username`).
# Optionnel : sans lui, l'app retombe sur le domaine de production.
EXPO_PUBLIC_WEB_URL=https://twitninf.fr

# Clé Google Maps Android, injectée dans le manifeste au prebuild par
# `plugins/withGoogleMapsApiKey.js`. Sans elle, la Carte NF se rend en
# rectangle gris uni sur Android, sans aucune erreur JS (iOS n'en a pas besoin,
# Apple Maps ne demande pas de clé). À créer dans la console Google Cloud,
# restreinte à l'application Android `com.gasleboss.TwitNin`.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# Detection des mises a jour (voir src/services/updateCheck.ts). L'app n'etant
# sur aucun store, elle compare son propre numero de build a celui publie dans
# le flux ; si le flux est plus recent, elle affiche la page « une nouvelle
# version est disponible » avec le canal d'installation (Kospor Injection sur
# iOS, Kospor Store sur Android).
#
# Les deux variables sont renseignees AUTOMATIQUEMENT par les workflows CI a
# partir du gist AltStore — il n'y a rien a faire pour un build publie. Les
# laisser vides en local desactive simplement la verification, ce qui evite de
# proposer une mise a jour a qui vient de compiler son propre build.
EXPO_PUBLIC_UPDATE_FEED_URL=
EXPO_PUBLIC_BUILD_VERSION=

# Optionnel — pointe les scènes animées de la mascotte (src/config/scenes.ts)
# vers une machine de dev pendant qu'on en retouche une. Laisser vide : elles
# suivent alors automatiquement EXPO_PUBLIC_API_URL (…/anim), ce qui est le
# cas en production. HTTPS obligatoire hors localhost, comme les autres
# adresses de serveur ci-dessus.
EXPO_PUBLIC_SCENES_URL=
