# Copier ce fichier en `.env` (jamais versionné) et renseigner les vraies
# adresses. Sans ce fichier, l'app démarre en mode hors ligne : les écrans
# restent accessibles mais les fonctions réseau sont indisponibles.
#
# `EXPO_PUBLIC_*` est inliné par Metro au moment du build (@expo/metro-config
# le charge automatiquement) : ces variables doivent être présentes AVANT de
# lancer `expo start` / `expo run:ios` / le build CI, pas seulement au
# démarrage du serveur.

# Serveur API principal (auth, tweets, messagerie, etc.)
EXPO_PUBLIC_API_URL=https://api.exemple.org

# Serveur de stream (ingestion RTMPS, lecture HLS, chat du live)
EXPO_PUBLIC_STREAM_SERVER=https://stream.exemple.org

# Clé Google Maps Android, injectée dans le manifeste au prebuild par
# `plugins/withGoogleMapsApiKey.js`. Sans elle, la Carte NF se rend en
# rectangle gris uni sur Android, sans aucune erreur JS (iOS n'en a pas besoin,
# Apple Maps ne demande pas de clé). À créer dans la console Google Cloud,
# restreinte à l'application Android `com.gasleboss.TwitNin`.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
